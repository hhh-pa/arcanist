#!/bin/sh
# Stub rust-code-analysis-cli: serves rca-<path>.json per -p file,
# falling back to rca-<basename>.json (<path> is the -p relative path
# with ./ stripped, .rs stripped, and / flattened to -).
outdir=""
files=""
prev=""
for a in "$@"; do
  case "$prev" in
    -o) outdir="$a" ;;
    -p) files="$files $a" ;;
  esac
  prev="$a"
done
if [ -n "$STUB_LOG" ]; then
  printf '%s\n' "rca $*" >> "$STUB_LOG"
fi
if [ "$1" = "--version" ]; then
  echo "stub: rca 0.0.0"
  exit 0
fi
for f in $files; do
  mkdir -p "$outdir/$(dirname "$f")"
  key=$(printf '%s' "$f" | sed -e 's|^\./||' -e 's|\.rs$||' -e 's|/|-|g')
  if [ -f "$STUB_DATA/rca-$key.json" ]; then
    cat "$STUB_DATA/rca-$key.json" > "$outdir/$f.json"
  else
    cat "$STUB_DATA/rca-$(basename "$f" .rs).json" > "$outdir/$f.json"
  fi
done
