; http://editorconfig.org/ — matches the current tree (Rust + Go
; port; the old src/** PHP sections died with the PHP tree).

root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.go]
indent_style = tab
# gofmt owns the rest.

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
